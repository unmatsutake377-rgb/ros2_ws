// WS2812 스트립이 어느 핀에 물려 있는지 찾는 스케치 — 색으로 핀을 식별한다.
//
// 🎯 [2026-09-03] 실물은 **3가닥 = WS2812 스트립**으로 확인됐다.
//    그래서 핀을 그냥 HIGH 로 두는 시험은 의미가 없다 — 스트립은 전용 데이터 신호만 받는다.
//    (그전까지 핀 18·17 을 HIGH/LOW 로 흔들어 봤으나 당연히 무반응이었다)
//
// 원리: WS2812 는 **한 번 받은 색을 계속 유지**한다.
//   후보 핀을 차례로 훑으며 각각 **다른 색**을 보내면,
//   실제로 연결된 핀이 보낸 색만 스트립에 남는다.
//   → 사용자는 "무슨 색이 켜졌나" 만 답하면 된다. 타이밍을 맞출 필요가 없다.
//
// 🚨 제외한 핀
//   0, 1     : USB 시리얼
//   2, 3, 19 : RC 입력 — 수신기가 구동 중이다. 출력을 내면 서로 부딪혀 상한다
//   11, 12   : ESC 신호
//   13       : 내장 LED (대조군으로 계속 깜빡인다)
//
// 🚨 시험이 끝나면 반드시 ssf_boat.ino 를 다시 올릴 것.

#include <Adafruit_NeoPixel.h>

#define PIN_ONBOARD 13
const int NUM_PIXELS = 34;   // 실물 34개 (09-03 확인)
const int BRIGHTNESS = 5;    // 🎯 전원 한계 확인 — 최대의 2%. AA 3개로 34개를 못 버틴다

struct Cand { uint8_t pin; const char *color; uint8_t r, g, b; };

// 1라운드 후보 — 사용자가 지목한 14~21 대역 + 원래 펌웨어 값 40
// 🎯 2라운드 — 1라운드에서 "파랑" 이 보였다(= 핀 16). 단독 확인.
//    분홍(핀 20)과 섞여 보라로 보였을 수 있어, 후보를 둘로 줄여 번갈아 낸다.
//    한 색만 뚜렷하게 유지되면 그 핀이 답이다.
// 🎯 [09-03 재탐색] 아무것도 안 건드렸는데 핀 16 파랑이 안 켜진다 — 전체 재확인.
//    색으로 핀을 식별한다. 스트립에 남는 색 = 연결된 핀.
const Cand CANDS[] = {
  { 14, "빨강",   255,   0,   0 },
  { 15, "초록",     0, 255,   0 },
  { 16, "파랑",     0,   0, 255 },
  { 17, "노랑",   255, 200,   0 },
  { 18, "청록",     0, 255, 255 },
  { 20, "분홍",   255,   0, 150 },
  { 21, "흰색",   255, 255, 255 },
  { 40, "주황",   255,  60,   0 },
};
const int N = sizeof(CANDS) / sizeof(CANDS[0]);

Adafruit_NeoPixel strip(NUM_PIXELS, CANDS[0].pin, NEO_GRB + NEO_KHZ800);

void setup() {
  Serial.begin(115200);
  pinMode(PIN_ONBOARD, OUTPUT);
  strip.begin();
  strip.setBrightness(BRIGHTNESS);
  Serial.println(F("=== 핀 찾기 — 색으로 식별 ==="));
  for (int i = 0; i < N; i++) {
    Serial.print(F("  pin ")); Serial.print(CANDS[i].pin);
    Serial.print(F(" -> ")); Serial.println(CANDS[i].color);
  }
  Serial.println(F("스트립에 남는 색을 알려주십시오."));
}

// 🎯 픽셀 개수 세기 — 1개부터 하나씩 늘려가며 켠다.
//    "몇 개까지 켜지다가 멈추는가" 가 곧 실물 개수다.
//    색도 3개마다 바꿔 세기 쉽게 한다.
// 소등 모드 — 스트립을 끄고 유지한다.
// 부팅 직후 한 번만 보내면 되지만, 전원이 잠깐 흔들려도 다시 꺼지도록 주기적으로 보낸다.
// 점등 모드 — 핀 16 에 파랑을 계속 보낸다.
// 배선을 옮기며(LED2 의 DIN 등) 어디서 살아나는지 볼 때 쓴다.
// 주기적으로 다시 보내므로, 선을 옮기면 바로 반응이 나타난다.
// 🎯 [09-03] 연결 지점 바로 다음 1개만 켜진다 — 위치를 옮겨도 같다.
//    특정 LED 하나가 죽은 게 아니라 **전부가 다음으로 데이터를 못 넘기는** 상태다.
//    원인 후보: ① 스트립 뒷부분 전원 없음  ② 통신 속도 불일치(WS2811=400kHz)
//    ②는 배선을 안 건드리고 시험할 수 있으므로 여기서 두 속도를 번갈아 보낸다.
// 🎯 [09-03] LED 34개. 최대 밝기면 2A 가까이 먹는다 — AA 3개로는 못 버틴다.
//    전압이 주저앉으면 첫 개만 겨우 켜지고 나머지는 동작을 못 한다.
//    밝기를 20(8%)으로 낮춰 전류를 1/10 이하로 줄이고, 켜지는 개수를 본다.
//      여러 개 켜짐 → 전원 부족 확정 (밝기를 낮추거나 전원을 보강)
//      여전히 1개   → 전원 문제 아님. 스트립 데이터 사슬 문제
// 🎯 [09-03] 직결하니 34개가 순간 전부 켜졌다가 꺼졌다 — **데이터 사슬은 정상**이고
//    전원(AA 3개)이 34개를 못 버틴다는 뜻이다.
//    여기서는 밝기를 5(2%)로 낮추고 켜는 개수를 1→34 로 서서히 늘린다.
//    **몇 개에서 무너지는지** 가 곧 지금 전원이 감당하는 한계다.
//
//    🚨 setBrightness 는 show() 전에 적용돼야 한다. 첫 프레임이 최대로 나가지 않도록
//       루프 안에서 매번 다시 지정한다(아까 "밝기가 안 바뀐다" 관찰의 대비책).
// 점등 — 파랑 고정, 밝기 5(어두움). 34개분을 0.2초마다 재전송.
// 전체 핀 훑기 — 각 핀에 서로 다른 색을 반복 송출. 밝기는 잘 보이게 60.
// A/B 시험 — 본 펌웨어는 못 바꾸는 색을 시험 코드가 바꿀 수 있는지.
// 빨강 고정, 핀 16, 0.3초마다 재전송.
// 재스캔 — 핀 16 고정 송출이 안 닿는다. 점퍼가 옆 칸으로 밀렸을 수 있어
// 후보 전체를 다시 훑는다. 켜지는 색 = 실제 꽂힌 핀.
// 판정 고정 — 핀 16 에 초록만 계속. 스캔의 "뜬 핀 노이즈" 변수를 제거한다.
void loop() {
  strip.setPin(16);
  strip.updateType(NEO_GRB + NEO_KHZ800);
  strip.setBrightness(60);
  strip.fill(strip.Color(0, 255, 0));
  strip.show();
  digitalWrite(PIN_ONBOARD, (millis() / 500) % 2);
  delay(300);
}
