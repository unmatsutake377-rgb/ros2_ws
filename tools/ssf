#!/usr/bin/env bash
# ssf — MacBook 에서 배 노트북 파라미터를 보고 고친다 (SSH 로 배 노트북의 tools/ssf_param_core.py · ssf_param_app.py 를 부름)
#
#   ssf app a            A번배 파라미터 앱 (SSH 터널 + 서버 + 브라우저). 끄기 Ctrl+C
#   ssf app b            B번배 (포트 8766)
#   ssf app both         두 배 동시에 (탭 두 개)
#   ssf a init           이 별명(boat-a)이 붙는 노트북을 A번배로 등록 (처음 한 번)
#   ssf a get hold       이름 일부로 값 보기
#   ssf a set hold_dist_m 3.5 [--course main|tournament] [--node ship_back]
#   ssf a undo hold_dist_m
#   ssf a diff           저장소와 다른 값
#   ssf a log            바꾼 기록
#   ssf both set side_lock_enabled false --course tournament      두 배에 같이
#   ssf b wp             웨이포인트 파일 목록·검사 (보기만)
#   ssf b wp main        종합임무 웨이포인트 녹화 (배 노트북 tmux 안에서 녹화 도구). 끊기면 같은 명령으로 다시 붙음
#   ssf b wp tournament 1   토너먼트 레인 1 녹화 → ~/ssf_logs/waypoints_tournament_B_1.yaml   [--dry-run]
#   ssf b gps            GPS·RTK 상태 한 줄(🟢 FIXED / 🟡 FLOAT / 🟠 단독 / 🔴 위치 없음 / ⚫ 데이터 없음)
#   ssf b cam            D455 실시간 영상: 배 송신(tmux) + 이 Mac 수신 창. Ctrl+C 한 번이면 둘 다 끔
#   ssf b cam view|stop|status   수신 창만 / 배 송신 끄기 / 상태(D455 USB·로그)
#                        포트 A번배 5600 · B번배 5601 — 영상은 조종과 따로(꺼져도 RC 조종 그대로)
#
# 설치(MacBook, 한 번):  저장소가 있으면  echo 'alias ssf=~/ros2_ws/tools/ssf' >> ~/.zshrc
#                        없으면          scp boat-a:ros2_ws/tools/ssf ~/ssf && chmod +x ~/ssf && echo 'alias ssf=~/ssf' >> ~/.zshrc
# 바꿀 수 있는 환경변수: SSF_HOST_A(기본 boat-a) SSF_HOST_B(boat-b) SSF_REMOTE_REPO(~/ros2_ws)
#                        SSF_SSH(기본 ssh — 연습용 가짜 배는 tools/ssf_practice.sh 가 알려 줌)
#                        SSF_NO_OPEN=1 (브라우저 자동으로 안 열기)
set -u
# ServerAlive: 5 초마다 확인, 20 초 무응답이면 SSH 를 끊는다 — 와이파이·LTE 가 끊겼을 때 얼어붙은 채로
#   남아 포트를 잡고 있지 않게(남으면 'ssf app' 다시 켜기가 Address already in use 로 실패 — 11-10 시험)
SSH=${SSF_SSH:-ssh -o ServerAliveInterval=5 -o ServerAliveCountMax=4}
REMOTE_REPO=${SSF_REMOTE_REPO:-'~/ros2_ws'}

host_of() { case "$1" in A) echo "${SSF_HOST_A:-boat-a}";; B) echo "${SSF_HOST_B:-boat-b}";; esac; }
port_of() { case "$1" in A) echo 8765;; B) echo 8766;; esac; }
boats_of() {
  case "$(echo "$1" | tr '[:lower:]' '[:upper:]')" in
    A|1) echo A;; B|2) echo B;; BOTH|AB|ALL) echo "A B";; *) return 1;;
  esac
}
usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"; exit 2; }   # 맨 위 주석 덩어리

quote_args() { local out="" a; for a in "$@"; do out+=" $(printf '%q' "$a")"; done; echo "$out"; }

run_cli() {   # boat, args...
  local b=$1; shift
  local h; h=$(host_of "$b")
  echo "━━ $( [ "$b" = A ] && echo A번배 || echo B번배 ) ($h)"
  # shellcheck disable=SC2029  — 원격에서 펼치는 게 맞다
  $SSH "$h" "cd $REMOTE_REPO && python3 tools/ssf_param_core.py --boat $b$(quote_args "$@")"
}

open_url() {
  [ "${SSF_NO_OPEN:-0}" = 1 ] && return
  if command -v open >/dev/null; then open "$1"; elif command -v xdg-open >/dev/null; then xdg-open "$1" >/dev/null 2>&1; fi
}

app_link() {  # boat — SSH 로 앱 서버를 띄우고 포트를 잇는다. 끊기면 5 초 뒤 다시(Ctrl+C 까지)
  local b=$1 h p sp n=0 t0
  h=$(host_of "$b"); p=$(port_of "$b")
  trap 'kill $sp 2>/dev/null; exit 0' INT TERM
  while :; do
    t0=$(date +%s)
    # -L 로컬 포트 → 배 노트북 127.0.0.1 포트. -n: 키보드 입력 안 받음(두 배 동시 실행).
    # BatchMode: 비밀번호를 물으면 멈추지 말고 실패 → 키 등록(맥북_원격조작_설명서 1-3).
    # --exit-with-parent: SSH 가 끊기면 배 노트북 서버도 끝난다(남아도 다음 접속 때 stop_old 가 끈다).
    $SSH -n -o BatchMode=yes -o ExitOnForwardFailure=yes -L "$p:127.0.0.1:$p" "$h" \
      "cd $REMOTE_REPO && exec python3 tools/ssf_param_app.py --boat $b --port $p --exit-with-parent" &
    sp=$!
    wait $sp
    # 오래 붙어 있다 끊긴 것이면 처음부터 다시 센다
    [ $(( $(date +%s) - t0 )) -gt 60 ] && n=0
    n=$((n + 1))
    echo "⚠️ $(date +%H:%M:%S) $h 앱 연결이 끊겼다 — 5 초 뒤 다시 붙는다($n 번째). 브라우저 창은 그대로 두면 된다(아직 적용 안 한 값도 남아 있다). 그만: Ctrl+C"
    [ $n -ge 3 ] && echo "   계속 끊기면: ssh $h 가 되는지(tailscale status), 포트 $p 를 다른 창이 쓰는지(lsof -nP -iTCP:$p)"
    sleep 5
  done
}

run_app() {   # boats...
  local pids=() b h p
  for b in "$@"; do
    h=$(host_of "$b"); p=$(port_of "$b")
    echo "━━ $( [ "$b" = A ] && echo A번배 || echo B번배 ) 앱: $h → http://localhost:$p"
    app_link "$b" &
    pids+=($!)
  done
  trap 'kill "${pids[@]}" 2>/dev/null; wait; exit 0' INT TERM
  for b in "$@"; do
    p=$(port_of "$b")
    ok=0
    for _ in $(seq 1 60); do
      if curl -s -m 2 -o /dev/null "http://localhost:$p/api/ping"; then ok=1; break; fi
      sleep 0.25
    done
    if [ $ok = 1 ]; then open_url "http://localhost:$p"
    else echo "⚠️ $(host_of "$b") 앱이 15 초 안에 안 떴다 — 위 SSH 오류 확인(ssh $(host_of "$b") 이 비밀번호 없이 되는지, git pull 했는지). 계속 다시 시도한다"; fi
  done
  echo "끄기: Ctrl+C"
  wait
}

run_wp() {    # boat, [main|tournament <레인>] [--dry-run]
  local b=$1; shift
  local h dry=0 args=()
  h=$(host_of "$b"); local lb; lb=$(echo "$b" | tr AB ab)
  for x in "$@"; do [ "$x" = --dry-run ] && dry=1 || args+=("$x"); done
  if [ ${#args[@]} -eq 0 ]; then run_cli "$b" wp-list; return; fi
  case "${args[0]}" in
    main) [ ${#args[@]} -eq 1 ] || { echo "종합임무는 레인 없이: ssf $lb wp main" >&2; return 2; } ;;
    tournament) [ ${#args[@]} -eq 2 ] || { echo "레인 이름 필요: ssf $lb wp tournament 1" >&2; return 2; } ;;
    *) echo "모르는 코스 '${args[0]}' — main 또는 tournament <레인>" >&2; return 2 ;;
  esac
  local sess="ssf_wp_$b" want
  want="${args[0]}:${args[1]:-}"
  # tmux: SSH 가 끊겨도 녹화 도구가 살아 있다. -A = 이미 있으면 거기에 다시 붙는다(새로 안 띄움).
  #   이미 있는 세션이 다른 코스·레인이면 붙지 않는다(레인 2 를 레인 1 파일에 찍는 사고 방지).
  local chk="cur=\$(tmux show-options -qv -t $sess @ssf_wp 2>/dev/null); if tmux has-session -t $sess 2>/dev/null && [ \"\$cur\" != $(printf %q "$want") ]; then echo \"❌ 다른 녹화가 열려 있다(\${cur:-표시 없음 — 이전 버전으로 연 녹화}) — 그 녹화를 저장·종료(또는 앱 웨이포인트 탭)한 뒤 다시\"; exit 3; fi"
  local cmd="cd $REMOTE_REPO || exit 1; $chk; tmux new-session -A -s $sess$(quote_args bash tools/ssf_wp_record.sh "$b" "${args[@]}")"
  echo "━━ $( [ "$b" = A ] && echo A번배 || echo B번배 ) ($h) 웨이포인트 녹화 — tmux 세션 $sess"
  if [ $dry = 1 ]; then echo "  (시험) $SSH -t $h \"$cmd\""; return 0; fi
  $SSH -t "$h" "$cmd"
}

mac_ip() {   # 이 Mac 의 Tailscale 주소(배가 영상을 보낼 곳)
  local ip="" t
  for t in tailscale /Applications/Tailscale.app/Contents/MacOS/Tailscale; do
    command -v "$t" >/dev/null 2>&1 || [ -x "$t" ] || continue
    ip=$("$t" ip -4 2>/dev/null | head -1); [ -n "$ip" ] && break
  done
  echo "$ip"
}

cam_view() {   # boat — 이 Mac 에서 수신 창(cam_view.sh 를 배에서 받아 ~/.ssf_camrx_<포트>.sh 로 둔다)
  local b=$1 h port=5600 v
  h=$(host_of "$b"); [ "$b" = B ] && port=5601
  # 이름에 'cam_view.sh' 가 들어가면 cam_view.sh 의 중복 검사(이름만 본다)가 다른 배(다른 포트) 수신까지 막는다
  #   → 포트별 이름. 같은 포트 두 개는 cam_view.sh 의 'udpsrc port=' 검사가 그대로 막는다.
  v="$HOME/.ssf_camrx_${port}.sh"
  if $SSH -n -o BatchMode=yes "$h" "cat $REMOTE_REPO/tools/cam_view.sh" > "$v.new" 2>/dev/null && [ -s "$v.new" ]; then
    mv "$v.new" "$v"
  else
    rm -f "$v.new"; [ -s "$v" ] || { echo "❌ 배에서 cam_view.sh 를 못 받았다 — ssh $h 확인" >&2; return 1; }
  fi
  command -v gst-launch-1.0 >/dev/null 2>&1 || { echo "❌ 이 Mac 에 gstreamer 가 없다: brew install gstreamer" >&2; return 1; }
  echo "━━ 수신 창 — UDP ${port} ($( [ "$b" = A ] && echo A번배 || echo B번배 )). 끄기 Ctrl+C. 좌상단 시계(배 시각)가 멈추면 화면을 믿지 말 것"
  trap 'true' INT
  CAM_PORT=$port bash "$v"
  trap - INT
}

run_cam() {   # boat [view|stop|status]
  local b=$1 sub=${2:-} ip
  case "$sub" in
    status) run_cli "$b" cam status ;;
    stop) run_cli "$b" cam stop ;;
    view) cam_view "$b" ;;
    "")
      ip=$(mac_ip)
      [ -n "$ip" ] || { echo "❌ 이 Mac 의 Tailscale 주소를 못 찾았다 — tailscale status 확인" >&2; return 1; }
      run_cli "$b" cam start "$ip" || return 1
      # 터미널 창을 그냥 닫아도(HUP) 배 송신이 남지 않게
      trap 'run_cli "$b" cam stop >/dev/null 2>&1; exit 1' HUP TERM
      cam_view "$b"
      trap - HUP TERM
      echo; echo "수신 창을 닫았다 — 배 송신도 끈다"
      run_cli "$b" cam stop ;;
    *) echo "ssf $b cam [view|stop|status]" >&2; return 2 ;;
  esac
}

[ $# -ge 1 ] || usage
if [ "$1" = app ]; then
  boats=$(boats_of "${2:-a}") || usage
  # shellcheck disable=SC2086
  run_app $boats
  exit
fi
boats=$(boats_of "$1") || usage
shift
[ $# -ge 1 ] || usage
if [ "$1" = app ]; then
  # shellcheck disable=SC2086
  run_app $boats; exit
fi
if [ "$1" = wp ]; then
  shift
  # shellcheck disable=SC2086
  set -- $boats "$@"
  # 목록은 두 배 같이 볼 수 있지만, 녹화는 한 배씩
  if [ "$(echo $boats | wc -w)" -gt 1 ]; then
    for x in "$@"; do case "$x" in main|tournament) echo "녹화는 한 배씩: ssf a wp … 또는 ssf b wp …" >&2; exit 2;; esac; done
    rc=0; for b in $boats; do run_cli "$b" wp-list || rc=1; done; exit $rc
  fi
  run_wp "$@"; exit
fi
if [ "$1" = cam ]; then
  shift
  # shellcheck disable=SC2086
  [ "$(echo $boats | wc -w)" -eq 1 ] || { echo "영상은 한 배씩: ssf a cam … 또는 ssf b cam …" >&2; exit 2; }
  # shellcheck disable=SC2086
  run_cam $boats "$@"; exit
fi
rc=0
for b in $boats; do
  if [ "$1" = init ]; then run_cli "$b" init "$b" || rc=1; else run_cli "$b" "$@" || rc=1; fi
done
exit $rc
