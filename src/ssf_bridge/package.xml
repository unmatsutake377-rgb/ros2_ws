<?xml version="1.0"?>
<package format="3">
  <name>ssf_bridge</name>
  <version>0.1.0</version>
  <description>Motor_run(토픽) ↔ Arduino Mega(시리얼) 브릿지. 명령 송신 + 펌웨어 상태(/boat_mode 등) 수신.</description>

  <maintainer email="you@example.com">SSF</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <!-- pyserial. 없으면 노드가 임포트 단계에서 죽는다 -->
  <depend>python3-serial</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
