  <version>0.1.0</version>
  <description>mode 5 obstacle avoidance: low obstacles (LiDAR-invisible) camera map + look-around (doridori)</description>

  <maintainer email="you@example.com">SSF</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
