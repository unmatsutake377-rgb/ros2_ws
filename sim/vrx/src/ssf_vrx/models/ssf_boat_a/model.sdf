<?xml version="1.0" ?>
<!-- 생성 파일: python3 -m ssf_vrx.make_boat (손으로 고치지 말 것). S.S.F A -->
<sdf version="1.9">
  <model name="ssf_boat_a">
    <link name="base_link">
      <inertial>
        <pose>0 0 -0.05 0 0 0</pose>
        <mass>34.0</mass>
        <inertia><ixx>0.9942</ixx><iyy>7.9447</iyy><izz>8.6646</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="hull_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>1.66 0.55 0.22</size></box></geometry>
      </collision>
      <visual name="hull_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>1.66 0.55 0.22</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
      <visual name="mast_visual">
        <pose>0.15 0 0.5 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius>
                  <length>0.80</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>

      <!-- RPLIDAR A3 대역: 360°, 0.25°, 11 Hz, 25 m. 스캔 80° = 뱃머리가 되게 -80° 회전 -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.65 0.0 0.2 0 0 -1.39626</pose>
        <topic>/ssf/scan</topic>
        <update_rate>11</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1440</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range><min>0.2</min><max>25.0</max><resolution>0.01</resolution></range>
          <noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
      <!-- OAK-1 PoE 대역: 640x360, hfov 63.9°, 30 fps. 마스트 위 -->
      <sensor name="oak" type="camera">
        <pose>0.15 0.0 0.9 0 0 0</pose>
        <topic>/ssf/oak/rgb/image_raw</topic>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.11527</horizontal_fov>
          <image><width>640</width><height>360</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>300</far></clip>
          <noise type="gaussian"><mean>0.0</mean><stddev>0.007</stddev></noise>
        </camera>
      </sensor>
      <!-- IMU 대역 (iahrs): 100 Hz. ENU 쿼터니언 → sim_bridge 가 /imu/yaw_raw 로 -->
      <sensor name="imu" type="imu">
        <pose>0 0 0.3 0 0 0</pose>
        <topic>/ssf/imu</topic>
        <update_rate>100</update_rate>
        <always_on>1</always_on>
        <imu>
          <angular_velocity>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
          </angular_velocity>
        </imu>
      </sensor>
      <!-- ZED-F9P 대역: 1 Hz (north_goal_angle gps_stale_sec 2.5 가 1 Hz 전제) -->
      <sensor name="navsat" type="navsat">
        <pose>-0.45 0.0 0.25 0 0 0</pose>
        <topic>/ssf/navsat</topic>
        <update_rate>1</update_rate>
        <always_on>1</always_on>
      </sensor>

    </link>

    <link name="left_housing_link">
      <pose>-0.7 0.12 -0.16 0 0 0</pose>
      <inertial><mass>0.4</mass>
        <inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="left_housing_visual">
        <geometry><cylinder><radius>0.05</radius><length>0.11</length></cylinder></geometry>
        <pose>0 0 0 0 1.5708 0</pose>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <link name="left_prop_link">
      <pose>-0.76 0.12 -0.16 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="left_prop_visual">
        <geometry><cylinder><radius>0.038</radius><length>0.01</length></cylinder></geometry>
        <pose>0 0 0 0 1.5708 0</pose>
        <material><ambient>0.2 0.2 0.6 1</ambient><diffuse>0.2 0.2 0.6 1</diffuse></material>
      </visual>
    </link>
    <joint name="left_chasis_engine_joint" type="fixed">
      <parent>base_link</parent><child>left_housing_link</child>
    </joint>
    <joint name="left_engine_propeller_joint" type="revolute">
      <pose>0 0 0 1.5708 0 0</pose>
      <axis><xyz>1 0 0</xyz>
        <limit><effort>100</effort><velocity>300</velocity></limit>
        <dynamics><friction>0.05</friction><damping>0.05</damping></dynamics>
      </axis>
      <parent>left_housing_link</parent><child>left_prop_link</child>
    </joint>

    <link name="right_housing_link">
      <pose>-0.7 -0.12 -0.16 0 0 0</pose>
      <inertial><mass>0.4</mass>
        <inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="right_housing_visual">
        <geometry><cylinder><radius>0.05</radius><length>0.11</length></cylinder></geometry>
        <pose>0 0 0 0 1.5708 0</pose>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <link name="right_prop_link">
      <pose>-0.76 -0.12 -0.16 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="right_prop_visual">
        <geometry><cylinder><radius>0.038</radius><length>0.01</length></cylinder></geometry>
        <pose>0 0 0 0 1.5708 0</pose>
        <material><ambient>0.2 0.2 0.6 1</ambient><diffuse>0.2 0.2 0.6 1</diffuse></material>
      </visual>
    </link>
    <joint name="right_chasis_engine_joint" type="fixed">
      <parent>base_link</parent><child>right_housing_link</child>
    </joint>
    <joint name="right_engine_propeller_joint" type="revolute">
      <pose>0 0 0 1.5708 0 0</pose>
      <axis><xyz>1 0 0</xyz>
        <limit><effort>100</effort><velocity>300</velocity></limit>
        <dynamics><friction>0.05</friction><damping>0.05</damping></dynamics>
      </axis>
      <parent>right_housing_link</parent><child>right_prop_link</child>
    </joint>

    <plugin filename="libSurface.so" name="vrx::Surface">
      <link_name>base_link</link_name>
      <hull_length>1.494</hull_length>
      <hull_radius>0.15</hull_radius>
      <fluid_level>0.0</fluid_level>
      <points>
        <point>0.747 0.14 0.0</point>
        <point>-0.747 0.14 0.0</point>
      </points>
      <wavefield><topic>/vrx/wavefield/parameters</topic></wavefield>
    </plugin>

    <plugin filename="libSurface.so" name="vrx::Surface">
      <link_name>base_link</link_name>
      <hull_length>1.494</hull_length>
      <hull_radius>0.15</hull_radius>
      <fluid_level>0.0</fluid_level>
      <points>
        <point>0.747 -0.14 0.0</point>
        <point>-0.747 -0.14 0.0</point>
      </points>
      <wavefield><topic>/vrx/wavefield/parameters</topic></wavefield>
    </plugin>

    <plugin filename="libSimpleHydrodynamics.so" name="vrx::SimpleHydrodynamics">
      <link_name>base_link</link_name>
      <xDotU>0.0</xDotU><yDotV>0.0</yDotV><nDotR>0.0</nDotR>
      <xU>10.0</xU><xUU>25.0</xUU>
      <yV>40.0</yV><yVV>60.0</yVV>
      <zW>200.0</zW>
      <kP>20.0</kP><kPP>30.0</kPP>
      <mQ>40.0</mQ><mQQ>60.0</mQQ>
      <nR>6.0</nR><nRR>8.0</nRR>
    </plugin>

    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>left_engine_propeller_joint</joint_name>
      <thrust_coefficient>0.0001</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>47.0</max_thrust_cmd>
      <min_thrust_cmd>-35.0</min_thrust_cmd>
    </plugin>

    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>right_engine_propeller_joint</joint_name>
      <thrust_coefficient>0.0001</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>47.0</max_thrust_cmd>
      <min_thrust_cmd>-35.0</min_thrust_cmd>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>ssf_boat</robot_base_frame>
      <odom_publish_frequency>10</odom_publish_frequency>
      <odom_topic>/ssf/odometry</odom_topic>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
